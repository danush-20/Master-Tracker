<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_item_bg"
    android:padding="8dp"
    android:gravity="center">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/widget_curr_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_popup_sync"
            android:layout_alignParentEnd="true"
            android:tint="#808080" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_curr_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Classes"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
        
        <TextView
            android:id="@+id/widget_curr_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All classes over"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:gravity="center" />
            
        <Chronometer
            android:id="@+id/widget_curr_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
